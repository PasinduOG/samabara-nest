generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model budgets {
  id          Int        @id @default(autoincrement())
  family_id   Int
  category_id Int
  amount      Decimal    @db.Decimal(10, 2)
  month       DateTime   @db.Date
  created_at  DateTime   @default(now()) @db.Timestamp(0)
  categories  categories @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_budgets_categories1")
  families    families   @relation(fields: [family_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_budgets_families1")

  @@index([category_id], map: "fk_budgets_categories1_idx")
  @@index([family_id], map: "fk_budgets_families1_idx")
}

model categories {
  id           Int            @id @default(autoincrement())
  family_id    Int
  name         String         @db.VarChar(255)
  type         String         @db.VarChar(255)
  created_at   DateTime       @default(now()) @db.Timestamp(0)
  budgets      budgets[]
  families     families       @relation(fields: [family_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_categories_families1")
  transactions transactions[]

  @@index([family_id], map: "fk_categories_families1_idx")
}

model families {
  id           Int            @id @default(autoincrement())
  name         String         @db.VarChar(45)
  created_at   DateTime       @default(now()) @db.Timestamp(0)
  budgets      budgets[]
  categories   categories[]
  transactions transactions[]
  users        users[]
}

model transactions {
  id          Int        @id @default(autoincrement())
  family_id   Int
  user_id     Int
  category_id Int
  amount      Decimal    @db.Decimal(10, 2)
  date        DateTime   @db.Date
  description String?    @db.Text
  created_at  DateTime   @default(now()) @db.Timestamp(0)
  categories  categories @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_transactions_categories1")
  families    families   @relation(fields: [family_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_transactions_families1")
  users       users      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_transactions_users1")

  @@index([category_id], map: "fk_transactions_categories1_idx")
  @@index([family_id], map: "fk_transactions_families1_idx")
  @@index([user_id], map: "fk_transactions_users1_idx")
}

model users {
  id           Int            @id @default(autoincrement())
  family_id    Int
  username     String         @db.VarChar(255)
  name         String         @db.VarChar(255)
  email        String         @db.VarChar(255)
  password     String         @db.VarChar(255)
  role         String         @db.VarChar(255)
  created_at   DateTime       @default(now()) @db.Timestamp(0)
  updated_at   DateTime?      @db.Timestamp(0)
  transactions transactions[]
  families     families       @relation(fields: [family_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_families1")

  @@index([family_id], map: "fk_users_families1_idx")
}
